{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "shipwelldev/cornerstone-support",
    "type": "library",
    "description": "Evolving generators, stubs, standards, and installation guidance for Cornerstone Laravel applications.",
    "keywords": [
        "laravel",
        "livewire",
        "starter-kit",
        "code-generation",
        "developer-tools"
    ],
    "homepage": "https://github.com/shipwelldev/cornerstone-support",
    "license": "MIT",
    "authors": [
        {
            "name": "Ship Well Development",
            "homepage": "https://shipwell.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/shipwelldev/cornerstone-support/issues",
        "source": "https://github.com/shipwelldev/cornerstone-support"
    },
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "laravel/framework": "^13.20",
        "livewire/livewire": "^4.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.4",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-browser": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "ShipWell\\CornerstoneSupport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ShipWell\\CornerstoneSupport\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ShipWell\\CornerstoneSupport\\CornerstoneSupportServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "fix": "pint --format agent",
        "test": "pest --compact",
        "verify": [
            "pint --test --format agent",
            "@analyse",
            "@test"
        ]
    },
    "suggest": {
        "laravel/boost": "Required to discover and publish the package's agent guidelines and skills.",
        "pestphp/pest": "Required to generate and run Pest tests.",
        "pestphp/pest-plugin-browser": "Required to generate and run Pest browser tests.",
        "pestphp/pest-plugin-laravel": "Required to run Pest tests in Laravel applications."
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
